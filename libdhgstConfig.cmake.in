@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The GStreamer imported targets that libdhgstTargets.cmake links to, with the same names as in CMakeLists.txt
find_dependency(PkgConfig)
foreach(_dhgst_module
    "DHGST_GSTREAMER;gstreamer-1.0>=1.14"
    "DHGST_GST_APP;gstreamer-app-1.0"
    "DHGST_GST_VIDEO;gstreamer-video-1.0")
  list(GET _dhgst_module 0 _dhgst_prefix)
  list(GET _dhgst_module 1 _dhgst_spec)
  pkg_check_modules(${_dhgst_prefix} QUIET IMPORTED_TARGET ${_dhgst_spec})
  if(NOT ${_dhgst_prefix}_FOUND)
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "pkg-config module ${_dhgst_spec} not found")
    unset(_dhgst_module)
    unset(_dhgst_prefix)
    unset(_dhgst_spec)
    return()
  endif()
endforeach()
unset(_dhgst_module)
unset(_dhgst_prefix)
unset(_dhgst_spec)

include("${CMAKE_CURRENT_LIST_DIR}/libdhgstTargets.cmake")

set_and_check(libdhgst_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/dh/gst")
